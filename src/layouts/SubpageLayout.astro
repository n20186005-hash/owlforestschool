---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import OwlMark from '@/components/OwlMark.astro';

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  heroKicker?: string;
  heroTitle: string;
  heroSubtitle?: string;
  breadcrumbLabel: string;
  faqs?: FaqItem[];
  current?: 'opening-status' | 'parking-transport' | 'family-guide';
}

const {
  title,
  description,
  canonicalPath,
  heroKicker = 'OWL FOREST SCHOOL GUIDE',
  heroTitle,
  heroSubtitle,
  breadcrumbLabel,
  faqs = [],
  current,
} = Astro.props;

const siteUrl = 'https://owlforestschool.com';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '奧爾森林學堂旅遊指南',
      item: `${siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: breadcrumbLabel,
      item: `${siteUrl}${canonicalPath}`,
    },
  ],
};

const faqSchema = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;

const related: { slug: string; label: string; desc: string }[] = [
  { slug: 'opening-status', label: '開放狀況與施工', desc: '2026 分區施工、設施開放與最新公告核對' },
  { slug: 'parking-transport', label: '停車與交通', desc: '停車場入口、Google 導航、公車與步行動線' },
  { slug: 'family-guide', label: '親子遊玩攻略', desc: '樹屋、遊具與幼兒友善路線的實用建議' },
];
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <SiteHeader />

  <main>
    <section class="relative isolate min-h-[400px] overflow-hidden bg-[#14261d] pt-28 text-white">
      <div class="leaf-grid absolute inset-0 -z-10 opacity-40"></div>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(0deg,rgba(11,30,22,.92)_0%,rgba(11,30,22,.5)_100%)]"></div>
      <div class="mx-auto max-w-7xl px-5 pb-14 pt-8 lg:px-8">
        <p class="text-sm font-semibold tracking-[0.32em] text-[#e2bd72]">{heroKicker}</p>
        <h1 class="mt-5 text-4xl font-semibold tracking-tight sm:text-5xl lg:text-6xl">{heroTitle}</h1>
        {heroSubtitle && <p class="mt-5 max-w-2xl text-lg leading-8 text-white/70">{heroSubtitle}</p>}
        <nav class="mt-7 flex flex-wrap items-center gap-2 text-sm text-white/55" aria-label="麵包屑">
          <a class="transition hover:text-white" href="/">首頁</a>
          <span aria-hidden="true">／</span>
          <span class="text-white/85">{breadcrumbLabel}</span>
        </nav>
      </div>
    </section>

    <div class="mx-auto max-w-3xl px-5 py-16 lg:px-8">
      <slot />
    </div>

    <section class="mx-auto max-w-7xl px-5 pb-24 lg:px-8">
      <p class="text-sm font-semibold tracking-[0.22em] text-[#8a6b2b]">RELATED GUIDES</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[#173227]">延伸攻略</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-3">
        {
          related
            .filter((item) => item.slug !== current)
            .map((item) => (
              <a
                href={`/${item.slug}`}
                class="group rounded-[1.75rem] border border-[#ded7c8] bg-white p-6 transition hover:-translate-y-1 hover:border-[#82956d] hover:shadow-[0_18px_45px_rgba(42,54,46,.1)]"
              >
                <OwlMark class="h-9 w-9 text-[#82683a]" />
                <h3 class="mt-4 font-semibold text-[#173227]">{item.label}</h3>
                <p class="mt-2 text-sm leading-6 text-[#617168]">{item.desc}</p>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-[#36503f] transition group-hover:gap-2">
                  查看指南 <span aria-hidden="true">↗</span>
                </span>
              </a>
            ))
        }
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
