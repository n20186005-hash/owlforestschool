    <a class="flex-1 rounded-xl bg-[#e2bd72] px-3 py-3 text-center text-sm font-semibold text-[#173227]" href={site.mapUrl} target="_blank" rel="noopener noreferrer">導航</a>
  </div>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.route-tab'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.route-panel'));

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.route;
        tabs.forEach((item) => {
          const active = item === tab;
          item.setAttribute('aria-selected', String(active));
          item.classList.toggle('bg-[#173227]', active);
          item.classList.toggle('text-white', active);
          item.classList.toggle('border-[#173227]', active);
          item.classList.toggle('bg-white', !active);
          item.classList.toggle('text-[#42574c]', !active);
          item.classList.toggle('border-[#cfc7b6]', !active);
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.panel !== target;
        });
      });
    });

    const checks = Array.from(document.querySelectorAll<HTMLInputElement>('[data-check]'));
    const progress = document.querySelector<HTMLElement>('#check-progress');
    const updateProgress = () => {
      if (!progress) return;
      const count = checks.filter((item) => item.checked).length;
      progress.textContent = `已準備 ${count} / ${checks.length} 項`;
    };
    checks.forEach((check) => check.addEventListener('change', updateProgress));

    const galleryItems = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-open]'));
    const lightbox = document.querySelector<HTMLDialogElement>('#gallery-lightbox');
    const lightboxImage = document.querySelector<HTMLImageElement>('#gallery-lightbox-image');
    const lightboxCaption = document.querySelector<HTMLElement>('#gallery-lightbox-caption');
    const lightboxAuthor = document.querySelector<HTMLElement>('#gallery-lightbox-author');
    const lightboxCounter = document.querySelector<HTMLElement>('#gallery-lightbox-counter');
    const lightboxClose = document.querySelector<HTMLButtonElement>('[data-gallery-close]');
    const lightboxPrev = document.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const lightboxNext = document.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const lightboxBackdrop = document.querySelector<HTMLElement>('[data-gallery-backdrop]');
    let activePhoto = 0;

    const showPhoto = (index: number) => {
      const item = galleryItems[index];
      if (!item || !lightboxImage || !lightboxCaption || !lightboxAuthor || !lightboxCounter) return;
      activePhoto = index;
      lightboxImage.src = item.dataset.src || '';
      lightboxImage.alt = item.dataset.alt || '';
      lightboxCaption.textContent = item.dataset.caption || '';
      lightboxAuthor.textContent = `攝影：${item.dataset.author || ''}`;
      lightboxCounter.textContent = `${index + 1} / ${galleryItems.length}`;
    };

    const changePhoto = (offset: number) => {
      if (!galleryItems.length) return;
      showPhoto((activePhoto + offset + galleryItems.length) % galleryItems.length);
    };

    galleryItems.forEach((item, index) => {
      item.addEventListener('click', () => {
        if (!lightbox) return;
        showPhoto(index);
        lightbox.showModal();
      });
    });

    lightboxClose?.addEventListener('click', () => lightbox?.close());
    lightboxPrev?.addEventListener('click', () => changePhoto(-1));
    lightboxNext?.addEventListener('click', () => changePhoto(1));
    lightboxBackdrop?.addEventListener('click', (event) => {
      if (event.target === lightboxBackdrop) lightbox?.close();
    });
    lightbox?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') changePhoto(-1);
      if (event.key === 'ArrowRight') changePhoto(1);
    });

  </script>
