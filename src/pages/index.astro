---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import OwlMark from '@/components/OwlMark.astro';
import WeatherWidget from '@/components/WeatherWidget.astro';
import VisitorServices from '@/components/VisitorServices.astro';
import AudienceRoutes from '@/components/AudienceRoutes.astro';
import SeasonalGuide from '@/components/SeasonalGuide.astro';
import Conservation from '@/components/Conservation.astro';
import HistoryLegend from '@/components/HistoryLegend.astro';
import Attractions from '@/components/Attractions.astro';
import NearbyVisit from '@/components/NearbyVisit.astro';
import Itinerary from '@/components/Itinerary.astro';
import { checklist, faqs, galleryPhotos, highlights, nearbyFood, quickFacts, routes, site } from '@/data/site';

const touristAttractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${site.url}/#attraction`,
  name: site.name,
  alternateName: ['OwlForestSchool', `${site.name}（桃園市）`],
  description: site.description,
  url: site.url,
  isAccessibleForFree: true,
  image: [
    `${site.url}/images/owl-forest-hero.jpg`,
    `${site.url}/images/owl-forest-sign.jpg`,
    `${site.url}/images/owl-forest-treehouse.jpg`,
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '公園路42號',
    addressLocality: '桃園區',
    addressRegion: '桃園市',
    postalCode: '330',
    addressCountry: 'TW',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.coordinates.lat,
    longitude: site.coordinates.lng,
  },
  hasMap: site.mapsShareUrl,
  sameAs: [site.mapsShareUrl, site.govtTourismUrl],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: '奧爾森林學堂旅遊指南',
  url: site.url,
  logo: `${site.url}/favicon.svg`,
  sameAs: [site.mapsShareUrl, site.govtTourismUrl],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '奧爾森林學堂旅遊指南', item: site.url },
  ],
};
---
<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(touristAttractionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div id="top"></div>
  <SiteHeader />

  <main>
    <section class="relative isolate min-h-[760px] overflow-hidden bg-[#14261d] pt-16 text-white">
      <img
        src="/images/owl-forest-hero.jpg"
        alt="奧爾森林學堂（Owl Forest School）主視覺 - 桃園市虎頭山森林樹屋與空中步道"
        width="1024"
        height="683"
        fetchpriority="high"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
      />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(11,30,22,.94)_0%,rgba(11,30,22,.76)_47%,rgba(11,30,22,.2)_100%)]"></div>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(0deg,rgba(11,30,22,.88)_0%,transparent_42%)]"></div>
      <div class="leaf-grid absolute inset-0 -z-10 opacity-60"></div>

      <div class="mx-auto grid min-h-[700px] max-w-7xl items-end gap-12 px-5 pb-16 pt-24 md:items-center md:pb-20 lg:grid-cols-[1.1fr_.9fr] lg:px-8">
        <div class="max-w-3xl">
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-black/15 px-4 py-2 text-sm text-white/80 backdrop-blur">
            <span class="h-2 w-2 rounded-full bg-[#e2bd72]"></span>
            桃園虎頭山・免費親子森林景點
          </div>
          <p class="text-sm font-semibold tracking-[0.32em] text-[#e2bd72]">OWL FOREST SCHOOL</p>
          <h1 class="mt-5 text-5xl font-semibold tracking-tight sm:text-6xl lg:text-7xl">奧爾森林學堂</h1>
          <p class="mt-6 max-w-2xl text-xl leading-9 text-white/80 sm:text-2xl">
            穿梭樹梢，走進貓頭鷹的森林教室。
          </p>
          <p class="mt-6 max-w-xl leading-8 text-white/65">
            樹屋、空中步道與林下探索，適合安排一場輕鬆的桃園親子半日遊。
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a class="rounded-full bg-[#e2bd72] px-6 py-3.5 font-semibold text-[#173227] transition hover:-translate-y-0.5 hover:bg-[#f1d28b] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white" href="#status">查看行前資訊</a>
            <a class="rounded-full border border-white/30 bg-white/5 px-6 py-3.5 font-semibold text-white backdrop-blur transition hover:bg-white/12 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white" href={site.mapUrl} target="_blank" rel="noopener noreferrer">開啟導航 ↗</a>
          </div>
        </div>

        <aside class="max-w-md rounded-[2rem] border border-white/15 bg-[#13271e]/70 p-6 backdrop-blur-xl lg:justify-self-end" aria-label="快速資訊">
          <div class="flex items-start gap-4">
            <OwlMark class="h-12 w-12 shrink-0 text-[#e2bd72]" />
            <div>
              <p class="text-sm text-white/55">今天出發前先知道</p>
              <p class="mt-1 text-lg font-semibold">園區目前分區施工中</p>
            </div>
          </div>
          <div class="mt-6 grid grid-cols-2 gap-3 text-sm">
            <div class="rounded-2xl bg-white/7 p-4"><span class="block text-white/50">門票</span><strong class="mt-1 block">免費</strong></div>
            <div class="rounded-2xl bg-white/7 p-4"><span class="block text-white/50">停留</span><strong class="mt-1 block">1～2 小時</strong></div>
            <div class="rounded-2xl bg-white/7 p-4"><span class="block text-white/50">親子</span><strong class="mt-1 block">幼兒～國小</strong></div>
            <div class="rounded-2xl bg-white/7 p-4"><span class="block text-white/50">推車</span><strong class="mt-1 block">主動線友善</strong></div>
          </div>
        </aside>
      </div>
    </section>

    <section id="status" class="relative z-10 -mt-7 px-5 lg:px-8">
      <div class="mx-auto max-w-7xl rounded-[2rem] border border-[#d8cfbb] bg-[#fffdf7] p-6 shadow-[0_24px_70px_rgba(24,50,39,.12)] md:p-8">
        <div class="grid gap-7 lg:grid-cols-[auto_1fr_auto] lg:items-center">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#fff2cf] text-[#8a6220]" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 2.8 19h18.4L12 3Z"/><path d="M12 9v4.5M12 17h.01" stroke-linecap="round"/></svg>
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-3">
              <h2 class="text-xl font-semibold text-[#173227]">{site.status.label}</h2>
            </div>
            <p class="mt-3 leading-7 text-[#4f6258]">{site.status.summary}</p>
          </div>
          <p class="rounded-2xl bg-[#edf2e8] px-5 py-4 text-sm font-medium leading-6 text-[#36503f] lg:max-w-xs">{site.status.expectedCompletion}</p>
        </div>
      </div>
    </section>

    <section id="reviews" class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
      <div class="overflow-hidden rounded-[2rem] border border-[#d8cfbb] bg-[#fffdf7] p-6 shadow-[0_24px_70px_rgba(24,50,39,.1)] md:p-8">
        <div class="grid gap-6 md:grid-cols-[auto_1fr] md:items-center">
          <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#fff2cf] text-[#8a6220]" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-8 w-8" fill="currentColor"><path d="m12 2 2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.8 6.1 20.2l1.2-6.6L2.5 9l6.6-.9L12 2Z"/></svg>
            </div>
            <div>
              <p class="text-sm text-[#8a6b2b]">Google 地圖評價</p>
              <p class="mt-1 flex items-baseline gap-2">
                <span class="text-4xl font-semibold text-[#173227]">{site.rating.score}</span>
                <span class="text-sm text-[#5d6d64]">／ 5</span>
              </p>
            </div>
          </div>
          <div class="md:border-l md:border-[#e7ddc9] md:pl-6">
            <p class="text-lg font-semibold text-[#173227]">{site.rating.count.toLocaleString()} 則評價 · {site.rating.category}</p>
            <p class="mt-2 text-sm leading-7 text-[#5d6d64]">
              評分與評價數同步自谷歌地圖（Google Maps）用戶評價 · {site.rating.syncedAt} ·
              <a href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-[#36503f] underline underline-offset-2 hover:text-[#173227]">點擊查看谷歌地圖全部評價 ↗</a>
            </p>
          </div>
        </div>
        <div class="mt-6 flex flex-col gap-4 border-t border-[#e7ddc9] pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="max-w-2xl text-xs leading-6 text-[#7c8a80]">
            同步自 Google 地圖用戶評價，同步時間 {site.rating.syncedAt}；版權歸原作者與 Google 地圖所有。
          </p>
          <a href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center gap-2 rounded-full bg-[#173227] px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-[#254838] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#173227]">
            在谷歌地圖查看全部評價
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <WeatherWidget />

    <section id="highlights" class="mx-auto max-w-7xl px-5 py-24 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
        <div class="relative">
          <div class="photo-mask overflow-hidden bg-[#dfe7d8]">
            <img src="/images/owl-forest-treehouse.jpg" alt="奧爾森林學堂（桃園市虎頭山）林間樹屋、空中步道與貓頭鷹裝置" width="940" height="627" loading="lazy" class="aspect-[4/3] h-full w-full object-cover" />
          </div>
          <div class="absolute -bottom-5 right-3 rounded-2xl bg-[#173227] px-5 py-4 text-white shadow-xl sm:right-8">
            <p class="text-2xl font-semibold">3 座</p>
            <p class="mt-1 text-xs text-white/60">代表性活樹屋</p>
          </div>
        </div>
        <div>
          <p class="text-sm font-semibold tracking-[0.22em] text-[#8a6b2b]">FOREST HIGHLIGHTS</p>
          <h2 class="mt-4 text-4xl font-semibold tracking-tight text-[#173227] sm:text-5xl">關於奧爾森林學堂：樹梢上的自然教室</h2>
          <p class="mt-6 max-w-2xl text-lg leading-9 text-[#52645a]">
            奧爾森林學堂在既有林木間搭起空中步道，讓樹屋與森林一起生長。這裡不是大型遊樂園，而是一個能慢慢觀察、探索與放電的城市森林空間。
          </p>
          <div class="mt-10 grid gap-5 sm:grid-cols-3">
            {highlights.map((item, index) => (
              <article class="rounded-[1.5rem] border border-[#ded7c8] bg-white p-5">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#eef2e8] text-sm font-semibold text-[#42604d]">0{index + 1}</span>
                <h3 class="mt-5 font-semibold text-[#173227]">{item.title}</h3>
                <p class="mt-3 text-sm leading-7 text-[#617168]">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <Attractions />

    <HistoryLegend />

    <section id="gallery" class="bg-[#102018] py-24 text-white">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div>
          <div class="max-w-2xl">
            <p class="text-sm font-semibold tracking-[0.22em] text-[#e2bd72]">REAL SCENES</p>
            <h2 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">走進奧爾森林學堂</h2>
            <p class="mt-5 leading-8 text-white/60">從樹屋、空中步道到藏在林間的貓頭鷹，出發前先看看現場風景。</p>
          </div>
        </div>

        <div class="mt-12 grid auto-rows-[260px] gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:auto-rows-[180px]">
          {galleryPhotos.map((photo, index) => (
            <figure
              class:list={[
                'group relative isolate overflow-hidden rounded-[1.75rem] bg-[#1d362a]',
                index === 0 && 'sm:col-span-2 lg:col-span-2 lg:row-span-2',
                index === 1 && 'lg:row-span-2',
                index === 5 && 'sm:col-span-2 lg:col-span-3',
              ]}
            >
              <img
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading="lazy"
                class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
              />
              <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              <figcaption class="absolute inset-x-0 bottom-0 z-10 p-5">
                <p class="font-semibold">{photo.caption}</p>
                <p class="mt-1 text-xs text-white/60">攝影：{photo.author}</p>
              </figcaption>
              <button
                type="button"
                class="absolute inset-0 z-20 cursor-zoom-in rounded-[1.75rem] focus-visible:outline-2 focus-visible:outline-offset-[-5px] focus-visible:outline-[#e2bd72]"
                aria-label={`放大查看：${photo.caption}`}
                data-gallery-open
                data-index={index}
                data-src={photo.src}
                data-alt={photo.alt}
                data-caption={photo.caption}
                data-author={photo.author}
              ></button>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <dialog
      id="gallery-lightbox"
      class="m-0 h-dvh max-h-none w-screen max-w-none bg-transparent p-0 text-white backdrop:bg-black/90"
      aria-label="實景照片大圖預覽"
    >
      <div class="flex h-full w-full flex-col items-center justify-center bg-[#08110d]/95 px-4 py-6 sm:px-16" data-gallery-backdrop>
        <button
          type="button"
          class="absolute right-4 top-4 z-20 flex h-12 w-12 items-center justify-center rounded-full border border-white/15 bg-black/45 text-2xl text-white transition hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:right-7 sm:top-7"
          aria-label="關閉大圖"
          data-gallery-close
        >×</button>

        <button
          type="button"
          class="absolute left-3 top-1/2 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-black/45 text-3xl text-white transition hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:left-7 sm:h-14 sm:w-14"
          aria-label="上一張照片"
          data-gallery-prev
        >‹</button>

        <figure class="flex min-h-0 max-w-6xl flex-1 flex-col items-center justify-center">
          <img
            id="gallery-lightbox-image"
            src={galleryPhotos[0].src}
            alt={galleryPhotos[0].alt}
            class="min-h-0 max-h-[78vh] max-w-[calc(100vw-2rem)] rounded-2xl object-contain shadow-2xl sm:max-w-[calc(100vw-10rem)]"
          />
          <figcaption class="mt-4 text-center">
            <p id="gallery-lightbox-caption" class="font-semibold"></p>
            <p class="mt-1 text-sm text-white/55">
              <span id="gallery-lightbox-author"></span>
              <span aria-hidden="true">・</span>
              <span id="gallery-lightbox-counter"></span>
            </p>
          </figcaption>
        </figure>

        <button
          type="button"
          class="absolute right-3 top-1/2 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-black/45 text-3xl text-white transition hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:right-7 sm:h-14 sm:w-14"
          aria-label="下一張照片"
          data-gallery-next
        >›</button>
      </div>
    </dialog>

    <section class="bg-[#173227] py-24 text-white">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold tracking-[0.22em] text-[#e2bd72]">BEFORE YOU GO</p>
          <h2 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">一眼看懂行前資訊</h2>
          <p class="mt-5 leading-8 text-white/60">保留最常被問到的內容，手機打開就能快速確認。</p>
        </div>
        <div class="mt-12 grid gap-px overflow-hidden rounded-[2rem] bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
          {quickFacts.map(([label, value]) => (
            <div class="bg-[#173227] p-7 transition hover:bg-[#1d3b2f]">
              <p class="text-sm text-white/45">{label}</p>
              <p class="mt-3 text-xl font-semibold">{value}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="routes" class="mx-auto max-w-7xl px-5 py-24 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[.75fr_1.25fr]">
        <div>
          <p class="text-sm font-semibold tracking-[0.22em] text-[#8a6b2b]">ROUTE PLANNER</p>
          <h2 class="mt-4 text-4xl font-semibold tracking-tight text-[#173227] sm:text-5xl">今天想玩多久？</h2>
          <p class="mt-6 leading-8 text-[#617168]">依照停留時間切換路線。所有建議都能在施工期間彈性縮短或折返。</p>
          <div class="mt-8 flex flex-wrap gap-2" role="tablist" aria-label="選擇遊玩時間">
            {routes.map((route, index) => (
              <button
                class:list={[
                  'route-tab rounded-full border px-5 py-3 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#173227]',
                  index === 0 ? 'border-[#173227] bg-[#173227] text-white' : 'border-[#cfc7b6] bg-white text-[#42574c] hover:border-[#82956d]'
                ]}
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`route-${route.id}`}
                data-route={route.id}
              >
                {route.label}・{route.duration}
              </button>
            ))}
          </div>
        </div>

        <div class="rounded-[2rem] bg-[#eef2e8] p-6 sm:p-9">
          {routes.map((route, index) => (
            <article id={`route-${route.id}`} class="route-panel" role="tabpanel" hidden={index !== 0} data-panel={route.id}>
              <div class="flex flex-wrap items-center justify-between gap-4">
                <div>
                  <p class="text-sm text-[#68776e]">{route.audience}</p>
                  <h3 class="mt-2 text-3xl font-semibold text-[#173227]">{route.duration}</h3>
                </div>
                <span class="rounded-full bg-white px-4 py-2 text-sm font-semibold text-[#42604d]">步行強度：{route.effort}</span>
              </div>
              <p class="mt-6 leading-8 text-[#52645a]">{route.description}</p>
              <ol class="mt-8 grid gap-3">
                {route.stops.map((stop, stopIndex) => (
                  <li class="flex items-center gap-4 rounded-2xl bg-white/80 p-4">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#173227] text-sm font-semibold text-white">{stopIndex + 1}</span>
                    <span class="font-medium text-[#2c4437]">{stop}</span>
                  </li>
                ))}
              </ol>
              <p class="mt-6 rounded-2xl border border-[#d2dbc9] bg-white/55 p-4 text-sm leading-7 text-[#53675a]">{route.note}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <AudienceRoutes />

    <SeasonalGuide />

    <section class="overflow-hidden bg-[#f0eadc] py-24">
      <div class="mx-auto grid max-w-7xl gap-14 px-5 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:px-8">
        <div class="order-2 lg:order-1">
          <p class="text-sm font-semibold tracking-[0.22em] text-[#8a6b2b]">FAMILY CHECKLIST</p>
          <h2 class="mt-4 text-4xl font-semibold tracking-tight text-[#173227] sm:text-5xl">帶孩子出發前，記得這些</h2>
          <div class="mt-10 grid gap-3 sm:grid-cols-2">
            {checklist.map(([title, text], index) => (
              <label class="group flex cursor-pointer gap-3 rounded-2xl bg-white/75 p-4 transition hover:bg-white">
                <input class="mt-1 h-5 w-5 shrink-0 accent-[#365d4b]" type="checkbox" data-check={index} />
                <span>
                  <strong class="block text-[#244437]">{title}</strong>
