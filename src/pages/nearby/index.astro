---
import SubpageLayout from '@/layouts/SubpageLayout.astro';
const items = [
 {slug:'taoyuan-confucius-temple',name:'桃園孔廟',kind:'歷史文化',detail:'從大成門、庭院高差認識桃園的儒學建築。'},
 {slug:'hutoushan-accessible-trail',name:'虎頭山公園全齡友善步道',kind:'自然步行',detail:'沿森林短程散步，接續樹屋與林下觀察。'},
 {slug:'taoyuan-martyrs-shrine',name:'桃園忠烈祠暨神社文化園區',kind:'古蹟建築',detail:'走訪 1938 年建築群、參道與木構細節。'},
 {slug:'hutoushan-park',name:'虎頭山公園',kind:'公園與地景',detail:'多條步道、觀景空間及自然教育場域。'},
 {slug:'jingguo-plum-garden',name:'經國梅園',kind:'季節植物',detail:'了解虎頭山梅園與周邊園路，依季節觀察植物。'},
];
---
<SubpageLayout title="奧爾森林學堂周邊景點｜桃園孔廟、虎頭山步道與神社文化園區" description="從奧爾森林學堂出發，探索桃園孔廟、全齡友善步道、忠烈祠暨神社文化園區、虎頭山公園與經國梅園；各景點附獨立歷史、特色、路線和導航。" canonicalPath="/nearby" heroTitle="探索虎頭山周邊景點" heroSubtitle="把森林樹屋串成半日遊：親子步道、文化古蹟、梅園與自然觀察。" breadcrumbLabel="周邊景點">
  <section><h2 class="text-2xl font-semibold text-[#173227]">從奧爾森林學堂出發</h2><p class="mt-4 leading-8 text-[#52645a]">虎頭山不只有樹屋：附近的孔廟、全齡友善步道與忠烈祠文化園區，適合依步行體力自由組合。施工期間請依圍籬與管理單位公告調整。</p></section>
  <section class="mt-10 grid gap-5 sm:grid-cols-2">
    {items.map(item=><a href={'/nearby/'+item.slug} class="group rounded-[1.5rem] border border-[#ded7c8] bg-white p-6 transition hover:border-[#8b9e7c] hover:shadow-lg"><span class="text-xs font-semibold tracking-[.2em] text-[#8a6b2b]">{item.kind}</span><h2 class="mt-3 text-xl font-semibold text-[#173227]">{item.name}</h2><p class="mt-3 leading-7 text-[#52645a]">{item.detail}</p><span class="mt-5 inline-block font-semibold text-[#36503f]">閱讀景點指南 ↗</span></a>)}
  </section>
  <section class="mt-12 rounded-[1.5rem] bg-[#f2f6ed] p-6"><h2 class="text-2xl font-semibold text-[#173227]">如何安排半日遊？</h2><p class="mt-4 leading-8 text-[#52645a]">親子輕量：奧爾森林學堂 → 全齡友善步道 → 桃園孔廟。文化深度：奧爾森林學堂 → 桃園孔廟 → 桃園忠烈祠暨神社文化園區。想延長森林散步，可依體力加入虎頭山公園與經國梅園。</p><a class="mt-4 inline-block underline underline-offset-4 text-[#36503f]" href="/family-guide">參考親子路線攻略</a></section>
</SubpageLayout>