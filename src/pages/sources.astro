---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { site } from '@/data/site';
const references = [
  ['桃園孔廟','https://www.scenic.tycg.gov.tw/News_Content.aspx?n=9500&s=997280'],
  ['虎頭山公園全齡友善步道','https://travel.tycg.gov.tw/zh-tw/travel/nearby-attractions/1269'],
  ['桃園忠烈祠暨神社文化園區','https://travel.tycg.gov.tw/en/Travel/Attraction/1034'],
  ['虎頭山公園與經國梅園','https://playfulpark-taoyuan.tycg.gov.tw/playgrounds/63'],
  ['虎頭山環保公園','https://travel.tycg.gov.tw/zh-tw/Travel/Attraction/971'],
  ['桃園明倫三聖宮','https://www.scenic.tycg.gov.tw/News_Content.aspx?n=9500&s=997282'],
  ['虎頭山楓香林','https://www.scenic.tycg.gov.tw/News_Content.aspx?n=9500&s=997275'],
  ['桃園市土地公文化館','https://travel.tycg.gov.tw/zh-tw/travel/attraction/1404'],
  ['桃林鐵路','https://travel.tycg.gov.tw/zh-tw/travel/attraction/2180'],
  ['大有梯田生態公園','https://travel.tycg.gov.tw/zh-tw/travel/attraction/1577'],
  ['龜山眷村故事館','https://travel.tycg.gov.tw/zh-tw/travel/attraction/981'],
];
---
<BaseLayout title="資料來源與更新說明｜奧爾森林學堂" description="奧爾森林學堂及虎頭山周邊景點的 Google 評價、桃園官方旅遊資訊、實景照片與地圖資料來源。" canonicalPath="/sources">
 <SiteHeader />
 <main class="mx-auto min-h-[70vh] max-w-3xl px-5 pb-24 pt-32">
  <p class="text-sm font-semibold tracking-[.22em] text-[#8a6b2b]">SOURCES & UPDATES</p>
  <h1 class="mt-4 text-4xl font-semibold text-[#173227]">資料來源與更新說明</h1>
  <div class="mt-10 space-y-9 leading-8 text-[#586a60]">
   <section><h2 class="text-xl font-semibold text-[#244437]">Google 地圖評價</h2><p class="mt-2">奧爾森林學堂評分及評價數為 Google 地圖使用者評價參考快照：{site.rating.score} 分、{site.rating.count.toLocaleString('en-US')} 則，資料同步時間 {site.rating.syncedAt}。評論版權歸原作者與 Google 地圖所有。</p><a class="underline underline-offset-4" href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer">在 Google 地圖查看全部評價 ↗</a></section>
   <section><h2 class="text-xl font-semibold text-[#244437]">官方旅遊與開放資訊</h2><p class="mt-2">奧爾森林學堂介紹、公共遊憩資訊及部分景點資料參考桃園市政府公開資訊；施工、開放及交通可能調整，出發前以主管單位及現場公告為準。本站內容最後校對：{site.reviewedAt}。</p><a class="underline underline-offset-4" href={site.govtTourismUrl} target="_blank" rel="noopener noreferrer">桃園觀光導覽網（奧爾森林學堂） ↗</a></section>
   <section><h2 class="text-xl font-semibold text-[#244437]">實景照片</h2><p class="mt-2">首頁部分實景影像取自 Wikimedia Commons，作者與授權資訊沿用原照片牆標示；周邊景點專頁的實景照片參照桃園市政府公開景點影像。已發布影像均保留。</p></section>
   <section><h2 class="text-xl font-semibold text-[#244437]">Google 地圖與導航</h2><p class="mt-2">奧爾森林學堂主頁使用景點地圖分享連結；周邊專頁使用對應景點名稱及位置的 Google Maps 專屬搜尋連結，供導航與入口查詢。</p><a class="underline underline-offset-4" href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer">開啟奧爾森林學堂 Google 地圖 ↗</a></section>
   <section><h2 class="text-xl font-semibold text-[#244437]">周邊景點逐頁參考資料</h2><p class="mt-2">以下官方頁面供查閱景點背景、管理與現況：</p><ul class="mt-3 list-disc space-y-2 pl-6">{references.map(([name,url])=><li><a class="underline underline-offset-4" href={url} target="_blank" rel="noopener noreferrer">{name} · 官方資料 ↗</a></li>)}</ul><a class="mt-5 inline-block underline underline-offset-4" href="/nearby">返回全部周邊景點</a></section>
  </div>
 </main>
 <SiteFooter />
</BaseLayout>
