---
import SubpageLayout from '@/layouts/SubpageLayout.astro';
import { site } from '@/data/site';

const faqs = [
  {
    q: '奧爾森林學堂有專屬停車場嗎？',
    a: '園區本身沒有獨立停車場，車輛多就近停於桃園孔廟周邊與虎頭山公園停車區，再步行進入；孔廟停車場距離入口最近，週末與連假最容易滿位。',
  },
  {
    q: '怎麼用 Google 地圖導航過去？',
    a: '可直接使用頁面與首頁的「開啟導航」按鈕，或搜尋「奧爾森林學堂」；Google 地圖 Plus Code 為 ' + site.plusCode + '，位於桃園市桃園區公園路 42 號（虎頭山公園內、孔廟旁）。',
  },
  {
    q: '可以搭大眾運輸嗎？',
    a: '可搭乘公車於虎頭山公園、三聖宮等鄰近站點下車，再步行進入園區；確切路線、班次與停靠位置會依年度調整，出發前請以桃園市公車動態系統或 Google 地圖即時資訊為準。',
  },
  {
    q: '施工會影響停車嗎？',
    a: '虎頭山公園改造工程可能調整部分停車格位與動線，建議上午 9 點前抵達；滿位時可續往園內其他停車區或周邊路邊格位尋找車位，並參考開放狀況頁面的最新公告。',
  },
];
---

<SubpageLayout
  title="奧爾森林學堂停車與交通｜停車場、公車與步行動線"
  description={'奧爾森林學堂（桃園虎頭山）怎麼去？整理孔廟停車場、Google 地圖導航、Plus Code、公車與步行進園動線，以及施工期間的停車替代方案。'}
  canonicalPath="/parking-transport"
  heroTitle="停車與交通"
  heroSubtitle="前往桃園市奧爾森林學堂的停車場入口、導航方式、大眾運輸與步行動線，一次看懂怎麼到、車停哪裡。"
  breadcrumbLabel="停車與交通"
  faqs={faqs}
  current="parking-transport"
>
  <section>
    <p class="text-sm font-semibold tracking-[0.22em] text-[#8a6b2b]">OVERVIEW</p>
    <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[#173227]">園區沒有獨立停車場</h2>
    <p class="mt-5 leading-8 text-[#52645a]">{site.transport.parkingIntro}</p>
  </section>

  <section class="mt-14">
    <p class="text-sm font-semibold tracking-[0.22em] text-[#8a6b2b]">PARKING</p>
    <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[#173227]">桃園孔廟停車場</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <div class="rounded-[1.5rem] border border-[#ded7c8] bg-[#fffdf7] p-6">
        <p class="text-sm text-[#8a6b2b]">車位</p>
        <p class="mt-2 font-semibold text-[#173227]">{site.transport.kongMiaoParking.spaces}</p>
      </div>
      <div class="rounded-[1.5rem] border border-[#ded7c8] bg-[#fffdf7] p-6">
        <p class="text-sm text-[#8a6b2b]">距離</p>
        <p class="mt-2 font-semibold text-[#173227]">{site.transport.kongMiaoParking.distance}</p>
      </div>
      <div class="rounded-[1.5rem] border border-[#ded7c8] bg-[#fffdf7] p-6 sm:col-span-2">
        <p class="text-sm text-[#8a6b2b]">假日提醒</p>
        <p class="mt-2 leading-7 text-[#52645a]">{site.transport.kongMiaoParking.holidayNote}</p>
      </div>
    </div>
  </section>

  <section class="mt-14">
    <p class="text-sm font-semibold tracking-[0.22em] text-[#8a6b2b]">ALTERNATIVES</p>
    <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[#173227]">停滿了怎麼辦？</h2>
    <ul class="mt-6 space-y-3">
      {
        site.transport.parkingAlternatives.map((item) => (
          <li class="flex gap-3 rounded-[1.5rem] border border-[#ded7c8] bg-white p-5 leading-7 text-[#52645a]">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#8a6b2b]" aria-hidden="true"></span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14">
    <p class="text-sm font-semibold tracking-[0.22em] text-[#8a6b2b]">NAVIGATION</p>
    <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[#173227]">導航與地圖定位</h2>
    <div class="mt-6 rounded-[1.5rem] border border-[#ded7c8] bg-[#fffdf7] p-6">
      <p class="leading-7 text-[#52645a]">
        地址：<strong class="text-[#244437]">{site.address}</strong>
      </p>
      <p class="mt-3 leading-7 text-[#52645a]">
        Google 地圖 Plus Code：<strong class="text-[#244437]">{site.plusCode}</strong>
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a class="inline-flex rounded-full bg-[#e2bd72] px-6 py-3.5 font-semibold text-[#173227] transition hover:-translate-y-0.5 hover:bg-[#f0d28e]" href={site.mapUrl} target="_blank" rel="noopener noreferrer">使用 Google 地圖導航 ↗</a>
        <a class="inline-flex rounded-full border border-[#cfc7b6] bg-white px-6 py-3.5 font-semibold text-[#42574c] transition hover:border-[#82956d]" href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer">在 Google 地圖查看 ↗</a>
      </div>
    </div>
  </section>

  <section class="mt-14">
    <p class="text-sm font-semibold tracking-[0.22em] text-[#8a6b2b]">PUBLIC TRANSIT</p>
    <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[#173227]">公車與步行</h2>
    <p class="mt-5 leading-8 text-[#52645a]">{site.transport.busIntro}</p>
    <p class="mt-3 leading-8 text-[#52645a]">{site.transport.busNote}</p>
    <p class="mt-4 rounded-[1.5rem] bg-[#edf2e8] p-5 text-sm leading-7 text-[#36503f]">
      下車後跟著「虎頭山公園」「孔廟」指標步行，約數分鐘即可抵達奧爾森林學堂；從孔廟停車場走進園區是最短的路線。
    </p>
  </section>

  <section class="mt-14">
    <p class="text-sm font-semibold tracking-[0.22em] text-[#8a6b2b]">CONSTRUCTION</p>
    <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[#173227]">施工期間的交通影響</h2>
    <p class="mt-5 leading-8 text-[#52645a]">
      虎頭山公園改造工程可能調整部分停車格位與園區動線，週末與連假車位更為緊張。建議預留彈性、錯峰抵達，並依現場指標與引導行走；最新範圍與公告請參考
      <a href="/opening-status" class="font-semibold text-[#36503f] underline underline-offset-2 hover:text-[#173227]">開放狀況與施工頁面</a>。
    </p>
  </section>

  <section class="mt-14">
    <p class="text-sm font-semibold tracking-[0.22em] text-[#8a6b2b]">CONTACT</p>
    <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[#173227]">管理單位聯絡</h2>
    <p class="mt-5 leading-8 text-[#52645a]">
      景點管理單位電話：<a href={`tel:${site.phone.replace(/\s/g, '')}`} class="font-semibold text-[#36503f]">{site.phone}</a>
    </p>
    <p class="mt-3 text-sm leading-7 text-[#7c8a80]">{site.phoneNote}</p>
  </section>

  <section class="mt-14">
    <p class="text-sm font-semibold tracking-[0.22em] text-[#8a6b2b]">FAQ</p>
    <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[#173227]">常見問題</h2>
    <div class="mt-6 divide-y divide-[#ded7c8] border-y border-[#ded7c8]">
      {
        faqs.map((item, index) => (
          <details class="group py-2" open={index === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-4 font-semibold text-[#244437]">
              <span>{item.q}</span>
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#edf2e8] text-xl transition group-open:rotate-45" aria-hidden="true">＋</span>
            </summary>
            <p class="max-w-3xl pb-5 pr-10 leading-8 text-[#607067]">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</SubpageLayout>
