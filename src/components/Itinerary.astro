---
import { site } from '@/data/site';
const { itinerary } = site;
---
<section id="itinerary" class="mx-auto max-w-7xl px-5 py-24 lg:px-8">
  <div class="max-w-3xl">
    <p class="text-sm font-semibold tracking-[0.22em] text-[#8a6b2b]">DAY TRIP</p>
    <h2 class="mt-4 text-4xl font-semibold tracking-tight text-[#173227] sm:text-5xl">桃園親子景點一日遊</h2>
    <p class="mt-6 text-lg leading-9 text-[#52645a]">{itinerary.intro}</p>
  </div>

  <ol class="mt-12 grid gap-5 lg:grid-cols-2">
    {itinerary.steps.map((step) => (
      <li class="scroll-mt-24 rounded-[2rem] border border-[#ded7c8] bg-white p-6 shadow-[0_18px_45px_rgba(42,54,46,.08)]">
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-xl font-semibold tracking-tight text-[#173227]">{step.title}</h3>
          <span class="shrink-0 inline-flex items-center rounded-full bg-[#173227] px-3 py-1 text-sm font-semibold text-[#e2bd72]">{step.time}</span>
        </div>
        <p class="mt-3 leading-8 text-[#5d6d64]">{step.text}</p>
        <a href={step.link.href} class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-[#36503f] underline underline-offset-2 hover:text-[#173227]">{step.link.label} ↗</a>
      </li>
    ))}
  </ol>

  <p class="mt-8 rounded-2xl border border-[#d9cfbc] bg-[#fffdf7] px-5 py-4 text-sm leading-6 text-[#617168]">{itinerary.note}</p>
</section>
