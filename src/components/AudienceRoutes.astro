---
import { audienceRoutes } from '@/data/guide';
---

<section id="audience-routes" class="mx-auto max-w-7xl px-5 py-24 lg:px-8">
  <div class="max-w-3xl">
    <p class="text-sm font-semibold tracking-[0.22em] text-[#8a6b2b]">PLANS BY TRAVELER</p>
    <h2 class="mt-4 text-4xl font-semibold tracking-tight text-[#173227] sm:text-5xl">按出行組成，挑一條路線</h2>
    <p class="mt-6 text-lg leading-9 text-[#52645a]">
      不同同行者的節奏不同。先依對象選路線，再搭配上方的時間長度，就能排出最順的半日或全日行程。
    </p>
  </div>

  <div class="mt-12 grid gap-6 lg:grid-cols-3">
    {audienceRoutes.map((route, i) => (
      <article class="flex h-full flex-col rounded-[2rem] border border-[#ded7c8] bg-[#fffdf7] p-7">
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-2xl font-semibold text-[#173227]">{route.audience}</h3>
          <span class="rounded-full bg-[#edf2e8] px-3.5 py-2 text-xs font-semibold text-[#36503f]">0{i + 1}</span>
        </div>
        <div class="mt-4 flex flex-wrap gap-2 text-sm">
          <span class="rounded-full border border-[#cfc7b6] px-3 py-1.5 font-medium text-[#42574c]">{route.duration}</span>
          <span class="rounded-full border border-[#cfc7b6] px-3 py-1.5 font-medium text-[#42574c]">步調：{route.pace}</span>
        </div>
        <ol class="mt-6 grid gap-2.5">
          {route.stops.map((stop, s) => (
            <li class="flex items-center gap-3 rounded-2xl bg-[#eef2e8]/70 p-3.5">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#173227] text-sm font-semibold text-white">{s + 1}</span>
              <span class="font-medium text-[#2c4437]">{stop}</span>
            </li>
          ))}
        </ol>
        <p class="mt-6 rounded-2xl border border-[#d2dbc9] bg-white/55 p-4 text-sm leading-7 text-[#53675a]">{route.focus}</p>
      </article>
    ))}
  </div>
</section>
