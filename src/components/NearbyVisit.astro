---
import { site } from '@/data/site';
const { nearbyVisit } = site;
const nearbyLinks: Record<string, string> = {
  '桃園孔廟': '/nearby/taoyuan-confucius-temple',
  '孔廟': '/nearby/taoyuan-confucius-temple',
  '虎頭山全齡友善步道': '/nearby/hutoushan-accessible-trail',
  '虎頭山公園全齡友善步道': '/nearby/hutoushan-accessible-trail',
  '忠烈祠暨神社文化園區': '/nearby/taoyuan-martyrs-shrine',
  '桃園忠烈祠暨神社文化園區': '/nearby/taoyuan-martyrs-shrine',
  '經國梅園': '/nearby/jingguo-plum-garden',
};
const additionalPlaces = [
  {name:'虎頭山楓香林',desc:'梯田式林蔭、楓香葉色與安靜野餐坡地',slug:'fengxiang-grove'},
  {name:'虎頭山環保公園',desc:'舊掩埋場再生的城市眺望與環境教育空間',slug:'hutoushan-environmental-park'},
  {name:'桃園明倫三聖宮',desc:'觀察傳統廟宇石刻、屋脊和彩繪工藝',slug:'minglun-sansheng-temple'},
  {name:'桃園市土地公文化館',desc:'從祭祀器物與常民故事認識桃園地方文化',slug:'land-god-museum'},
  {name:'桃林鐵路自行車道',desc:'走讀工業鐵道轉型為城市綠廊的歷史',slug:'taolin-railway'},
  {name:'大有梯田生態公園',desc:'梯田地景、水域生態與親子休憩空間',slug:'dayou-terrace-park'},
  {name:'龜山眷村故事館',desc:'透過眷村家屋與生活物件探索地方記憶',slug:'military-village-story-house'},
];
---
<section id="nearby" class="mx-auto max-w-7xl px-5 py-24 lg:px-8">
  <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:items-center">
    <div>
      <p class="text-sm font-semibold tracking-[0.22em] text-[#8a6b2b]">NEARBY VISIT</p>
      <h2 class="mt-4 text-4xl font-semibold tracking-tight text-[#173227] sm:text-5xl">周邊順遊：孔廟・神社・虎頭山步道</h2>
      <p class="mt-6 text-lg leading-9 text-[#52645a]">{nearbyVisit.intro}</p>
      <p class="mt-6 rounded-2xl border border-[#d9cfbc] bg-[#fffdf7] px-5 py-4 text-sm leading-6 text-[#617168]">
        各景點的開放時間、參觀動線與活動以現場與官方公告為準；更多桃園觀光資訊可參考
        <a href={site.govtTourismUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-[#36503f] underline underline-offset-2 hover:text-[#173227]">桃園觀光導覽網 ↗</a>。
      </p>
      <a href="/nearby" class="mt-6 inline-flex rounded-full bg-[#173227] px-6 py-3 font-semibold text-white transition hover:bg-[#36503f]">探索全部周邊景點 ↗</a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
      {nearbyVisit.items.map((item) => (
        <article id={item.id} class="scroll-mt-24 flex gap-5 rounded-[2rem] border border-[#ded7c8] bg-white p-6 sm:p-7 shadow-[0_18px_45px_rgba(42,54,46,.08)]">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#eef2e8] text-sm font-semibold text-[#42604d]">{item.name.slice(0, 1)}</span>
          <div>
            <h3 class="text-2xl font-semibold tracking-tight text-[#173227]">{item.name}</h3>
            <p class="mt-3 leading-8 text-[#5d6d64]">{item.text}</p>
            {nearbyLinks[item.name] && <a class="mt-3 inline-block font-semibold text-[#36503f] underline underline-offset-4" href={nearbyLinks[item.name]}>閱讀景點專頁 ↗</a>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<section class="mx-auto max-w-7xl px-5 pb-20 lg:px-8" aria-labelledby="more-nearby-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div><p class="text-sm font-semibold tracking-[.22em] text-[#8a6b2b]">MORE NEARBY</p><h2 id="more-nearby-heading" class="mt-3 text-3xl font-semibold text-[#173227]">探索更多桃園周邊景點</h2></div>
    <a href="/nearby" class="font-semibold text-[#36503f] underline underline-offset-4">全部 12 處景點 ↗</a>
  </div>
  <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {additionalPlaces.map(place => <a href={'/nearby/'+place.slug} class="rounded-[1.5rem] border border-[#ded7c8] bg-white p-5 transition hover:border-[#8b9e7c] hover:shadow-md"><h3 class="text-lg font-semibold text-[#173227]">{place.name}</h3><p class="mt-2 leading-7 text-[#52645a]">{place.desc}</p><span class="mt-4 inline-block font-semibold text-[#36503f]">閱讀景點指南 ↗</span></a>)}
  </div>
</section>
